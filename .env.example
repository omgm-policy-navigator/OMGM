# Common
APP_ENV=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=marry_policy
POSTGRES_USER=marry_policy
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://marry_policy:change-me@postgres:5432/marry_policy

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TIMEOUT_SECONDS=30

# Policy pipeline
POLICY_SOURCE_TIMEOUT_SECONDS=30
POLICY_RAW_DATA_DIR=data/raw
POLICY_PROCESSED_DATA_DIR=data/processed
