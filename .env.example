# Common
APP_ENV=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_BASE_URL=http://localhost:8000
VITE_API_MODE=mock

# PostgreSQL
# Local development placeholder values only.
# Copy this file to .env and replace POSTGRES_PASSWORD before running Docker Compose.
POSTGRES_DB=marry_policy
POSTGRES_USER=marry_policy
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+asyncpg://marry_policy:replace-with-local-password@postgres:5432/marry_policy
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# Policy pipeline
POLICY_SOURCE_TIMEOUT_SECONDS=30
POLICY_RAW_DATA_DIR=data/raw
POLICY_PROCESSED_DATA_DIR=data/processed
