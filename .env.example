# Common
APP_ENV=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_BASE_URL=http://localhost:8000
VITE_API_MODE=mock

# PostgreSQL
# Local development placeholder values only.
# Copy this file to .env and replace POSTGRES_PASSWORD before running Docker Compose.
POSTGRES_DB=marry_policy
POSTGRES_USER=marry_policy
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+asyncpg://marry_policy:replace-with-local-password@postgres:5432/marry_policy
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2

# Anonymous session
ANONYMOUS_SESSION_COOKIE_NAME=anonymous_session
ANONYMOUS_SESSION_ABSOLUTE_TTL_MINUTES=1440
ANONYMOUS_SESSION_IDLE_TTL_MINUTES=60
ANONYMOUS_SESSION_COOKIE_SAMESITE=lax
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Operations and admin
REQUEST_MAX_BODY_BYTES=65536
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated direct proxy IPs allowed to supply X-Forwarded-For. Leave empty without a trusted reverse proxy.
TRUSTED_PROXY_IPS=
# Set a non-shared secret to enable POST /api/v1/admin/sessions/cleanup.
ADMIN_API_KEY=
